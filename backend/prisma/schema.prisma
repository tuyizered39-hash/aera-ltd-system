generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String    @unique
  password          String
  fullName          String
  role              Role      @default(WORKER)
  profilePicture    String?
  phone             String?
  isActive          Boolean   @default(true)
  lastLogin         DateTime?
  lastPasswordUpdate DateTime? @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  notifications     Notification[] @relation("UserNotifications")
  deliveries        Delivery[]    @relation("UserDeliveries")
  attendance        Attendance[]  @relation("UserAttendance")
  reports           Report[]      @relation("UserReports")
  payments          Payment[]     @relation("UserPayments")
  createdServices   Service[]     @relation("CreatedServices")
  
  @@map("users")
}

enum Role {
  ADMIN
  WORKER
}

// ============================================
// SERVICE MODEL
// ============================================
model Service {
  id                String        @id @default(uuid())
  serviceType       ServiceType
  clientName        String
  clientPhone       String?
  clientEmail       String?
  location          String?
  district          String
  amount            Float
  amountPaid        Float?
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentMode       PaymentMode?
  description       String?
  startDate         DateTime
  endDate           DateTime?
  status            ServiceStatus @default(ONGOING)
  
  tentQuantity      Int?
  decorationItems   Json?
  
  createdById       String
  createdBy         User          @relation("CreatedServices", fields: [createdById], references: [id], onDelete: SetNull)
  
  notes             String?
  isReported        Boolean       @default(false)
  reportDate        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  deliveries        Delivery[]    @relation("ServiceDeliveries")
  payments          Payment[]     @relation("ServicePayments")
  
  @@index([serviceType])
  @@index([status])
  @@index([createdAt])
  @@map("services")
}

enum ServiceType {
  IT_MAINTENANCE
  ELECTRICAL_INSTALLATION
  CONSTRUCTION
  GENERATOR_REPAIR
  OFFICE_STATIONARY
  DECORATION_SOUND
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMode {
  CASH
  MTN
  BANK
}

enum ServiceStatus {
  ONGOING
  COMPLETED
  CANCELLED
}

// ============================================
// DELIVERY MODEL
// ============================================
model Delivery {
  id                String        @id @default(uuid())
  serviceId         String
  service           Service       @relation("ServiceDeliveries", fields: [serviceId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation("UserDeliveries", fields: [userId], references: [id], onDelete: SetNull)
  itemsDelivered    Json
  deliveryDate      DateTime      @default(now())
  expectedReturn    DateTime
  actualReturn      DateTime?
  returnStatus      ReturnStatus  @default(PENDING)
  deliveryAddress   String
  notes             String?
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([returnStatus])
  @@index([deliveryDate])
  @@map("deliveries")
}

enum ReturnStatus {
  PENDING
  RETURNED
  OVERDUE
}

// ============================================
// PAYMENT MODEL
// ============================================
model Payment {
  id                String        @id @default(uuid())
  serviceId         String
  service           Service       @relation("ServicePayments", fields: [serviceId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation("UserPayments", fields: [userId], references: [id], onDelete: SetNull)
  amount            Float
  paymentMode       PaymentMode
  transactionRef    String?
  paymentDate       DateTime      @default(now())
  notes             String?
  recordedBy        String
  createdAt         DateTime      @default(now())
  
  @@index([paymentDate])
  @@index([paymentMode])
  @@map("payments")
}

// ============================================
// ATTENDANCE MODEL
// ============================================
model Attendance {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime          @default(now())
  status            AttendanceStatus  @default(PRESENT)
  checkInTime       DateTime          @default(now())
  checkOutTime      DateTime?
  notes             String?
  
  @@unique([userId, date])
  @@index([date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ============================================
// NOTIFICATION MODEL
// ============================================
model Notification {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title             String
  message           String
  type              NotificationType
  isRead            Boolean           @default(false)
  data              Json?
  createdAt         DateTime          @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  REPORT
  ATTENDANCE
  SERVICE
  DELIVERY
  SYSTEM
}

// ============================================
// REPORT MODEL - FIXED
// ============================================
model Report {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("UserReports", fields: [userId], references: [id], onDelete: Cascade)
  reportType        ReportType
  serviceType       ServiceType?
  data              Json
  fileUrl           String?
  generatedAt       DateTime          @default(now())
  isMonthly         Boolean           @default(false)
  month             String?
  year              Int?
  // ✅ NEW fields - properly indented
  isDaily           Boolean           @default(false)
  reportDate        DateTime          @default(now())
  sentToAdmin       Boolean           @default(false)
  sentAt            DateTime?
  
  @@index([userId])
  @@index([reportType])
  @@index([generatedAt])
  @@index([sentToAdmin])
  @@map("reports")
}

enum ReportType {
  DAILY
  MONTHLY
  SERVICE_SUMMARY
}

// ============================================
// SETTINGS MODEL
// ============================================
model Settings {
  id                String            @id @default(uuid())
  key               String            @unique
  value             Json
  updatedBy         String?
  updatedAt         DateTime          @updatedAt
  createdAt         DateTime          @default(now())
  
  @@map("settings")
}
